# Host build: STANDALONE=true NEXT_PUBLIC_APP_VERSION=0.6.0-careli.1 pnpm --filter @multica/web build
# The build runs on Debian/Ubuntu; retain that libc for native Node dependencies.
FROM node:22-bookworm-slim
ARG COMMIT
LABEL org.opencontainers.image.revision=$COMMIT
WORKDIR /app
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0
COPY --chown=node:node apps/web/.next/standalone ./
COPY --chown=node:node apps/web/.next/static ./apps/web/.next/static
COPY --chown=node:node apps/web/public ./apps/web/public
COPY --chown=node:node LICENSE NOTICE ./
USER node
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
